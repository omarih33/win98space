<!doctype html>
<html class="touch-styles" lang="{website.language}">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    {squarespace-headers}
    <link rel="stylesheet" href="https://unpkg.com/98.css">
  </head>

  <body id="{squarespace.page-id}" class="{squarespace.page-classes} desktop windows98-body">
    <div id="desktop" class="windows98-desktop">
      <div class="desktop-icons-container" aria-label="Desktop icons">
        <button class="desktop-icon" type="button" data-window="welcome-window">
          <img class="desktop-icon-img" src="/assets/icons/win98-document.svg" alt="">
          <span>Welcome.exe</span>
        </button>

        <button class="desktop-icon" type="button" data-window="content-window">
          <img class="desktop-icon-img" src="/assets/icons/win98-folder.svg" alt="">
          <span>Website.exe</span>
        </button>

        <button class="desktop-icon" type="button" data-window="about-window">
          <img class="desktop-icon-img" src="/assets/icons/win98-document.svg" alt="">
          <span>About.txt</span>
        </button>

        <button class="desktop-icon" type="button" data-window="blog-window">
          <img class="desktop-icon-img" src="/assets/icons/win98-folder.svg" alt="">
          <span>Blog (D:)</span>
        </button>

        <button class="desktop-icon" type="button" data-window="gallery-window">
          <img class="desktop-icon-img" src="/assets/icons/win98-folder.svg" alt="">
          <span>Gallery (E:)</span>
        </button>

        <button class="desktop-icon" type="button" data-window="computer-window">
          <img class="desktop-icon-img" src="/assets/icons/win98-computer.svg" alt="">
          <span>My Computer</span>
        </button>

        <button class="desktop-icon" type="button" data-window="control-panel-window">
          <span class="desktop-icon-glyph desktop-icon-glyph--settings">⚙</span>
          <span>Control Panel</span>
        </button>

        <button class="desktop-icon" type="button" data-window="help-window">
          <img class="desktop-icon-img" src="/assets/icons/win98-help.svg" alt="">
          <span>Help</span>
        </button>
      </div>

      <div class="recycle-container">
        <button class="desktop-icon recycle-bin" type="button" data-action="recycle-bin">
          <span class="desktop-icon-glyph desktop-icon-glyph--trash">♲</span>
          <span>Recycle Bin</span>
        </button>
      </div>

      <section class="window active welcome-window" id="welcome-window" aria-label="Welcome">
        <div class="title-bar window-header">
          <div class="title-bar-text window-title"><img class="title-icon" src="/assets/icons/win98-document.svg" alt=""> Welcome</div>
          <div class="title-bar-controls window-controls">
            <button aria-label="Minimize" data-action="minimize"></button>
            <button aria-label="Close" data-action="close"></button>
          </div>
        </div>
        <div class="window-body window-content welcome-content">
          <div class="dialog-row">
            <img class="dialog-icon-img" src="/assets/icons/win98-computer.svg" alt="">
            <div>
              <p><strong>Welcome to {website.siteTitle}.</strong></p>
              <p>This site is running in Squarespace 98 mode. Double-click the desktop icons or use the Start menu to move around.</p>
            </div>
          </div>
          <div class="dialog-actions">
            <button type="button" data-window="content-window">Open Website</button>
            <button type="button" data-action="close-parent">OK</button>
          </div>
        </div>
      </section>

      <section class="window content-window" id="content-window" aria-label="Content" hidden>
        <div class="title-bar window-header">
          <div class="title-bar-text window-title"><img class="title-icon" src="/assets/icons/win98-folder.svg" alt=""> {website.siteTitle} - Internet Explorer</div>
          <div class="title-bar-controls window-controls">
            <button aria-label="Minimize" data-action="minimize"></button>
            <button aria-label="Maximize" data-action="maximize"></button>
            <button aria-label="Close" data-action="close"></button>
          </div>
        </div>
        <div class="window-body window-content browser-window-body">
          <div class="browser-toolbar">
            <button type="button" data-window="welcome-window">Back</button>
            <button type="button" data-window="content-window">Home</button>
            <button type="button" data-window="help-window">Help</button>
            <label class="address-bar">Address: <input type="text" value="https://{website.siteTitle}/" readonly></label>
          </div>
          <nav class="menu-bar">
            <squarespace:navigation navigationId="siteNav" template="nav" />
          </nav>
          <main class="content-area" role="main" data-content-field="main-content">
            {squarespace.main-content}
          </main>
        </div>
        <div class="status-bar">
          <p class="status-bar-field">Done</p>
          <p class="status-bar-field">Local intranet</p>
          <p class="status-bar-field" id="status-time">--:--</p>
        </div>
      </section>

      <section class="window about-window" id="about-window" aria-label="About" hidden>
        <div class="title-bar window-header">
          <div class="title-bar-text window-title"><img class="title-icon" src="/assets/icons/win98-document.svg" alt=""> About.txt - Notepad</div>
          <div class="title-bar-controls window-controls">
            <button aria-label="Minimize" data-action="minimize"></button>
            <button aria-label="Maximize" data-action="maximize"></button>
            <button aria-label="Close" data-action="close"></button>
          </div>
        </div>
        <div class="window-body window-content notepad-content">
          <div class="notepad-toolbar">File&nbsp;&nbsp; Edit&nbsp;&nbsp; Search&nbsp;&nbsp; Help</div>
          <div class="notepad-text">
            <squarespace:block-field id="aboutContent" columns="1" />
          </div>
        </div>
      </section>

      <section class="window folder-window blog-window" id="blog-window" aria-label="Blog" hidden>
        <div class="title-bar window-header">
          <div class="title-bar-text window-title"><img class="title-icon" src="/assets/icons/win98-folder.svg" alt=""> Blog (D:) - Windows Explorer</div>
          <div class="title-bar-controls window-controls">
            <button aria-label="Minimize" data-action="minimize"></button>
            <button aria-label="Maximize" data-action="maximize"></button>
            <button aria-label="Close" data-action="close"></button>
          </div>
        </div>
        <div class="window-body window-content folder-window-body">
          <div class="computer-toolbar">
            <button type="button" data-window="computer-window">Back</button>
            <button type="button">Up</button>
            <label class="address-bar">Address: <input type="text" value="My Computer\Blog (D:)" readonly></label>
          </div>
          <div class="folder-intro">
            <img src="/assets/icons/win98-folder.svg" alt="">
            <div>
              <strong>Blog (D:)</strong>
              <p>Use this window for posts, field notes, essays, or updates. For now, add/edit content using the block field below.</p>
            </div>
          </div>
          <div class="folder-content blog-folder-content">
            <squarespace:block-field id="blogWindowContent" columns="12" />
          </div>
        </div>
        <div class="status-bar"><p class="status-bar-field">Ready</p><p class="status-bar-field">Blog folder</p></div>
      </section>

      <section class="window folder-window gallery-window" id="gallery-window" aria-label="Gallery" hidden>
        <div class="title-bar window-header">
          <div class="title-bar-text window-title"><img class="title-icon" src="/assets/icons/win98-folder.svg" alt=""> Gallery (E:) - Windows Explorer</div>
          <div class="title-bar-controls window-controls">
            <button aria-label="Minimize" data-action="minimize"></button>
            <button aria-label="Maximize" data-action="maximize"></button>
            <button aria-label="Close" data-action="close"></button>
          </div>
        </div>
        <div class="window-body window-content folder-window-body">
          <div class="computer-toolbar">
            <button type="button" data-window="computer-window">Back</button>
            <button type="button">Up</button>
            <label class="address-bar">Address: <input type="text" value="My Computer\Gallery (E:)" readonly></label>
          </div>
          <div class="folder-intro">
            <img src="/assets/icons/win98-folder.svg" alt="">
            <div>
              <strong>Gallery (E:)</strong>
              <p>Use this window for images, projects, screenshots, or portfolio pieces. Add a Gallery Block or image blocks below.</p>
            </div>
          </div>
          <div class="folder-content gallery-folder-content">
            <squarespace:block-field id="galleryWindowContent" columns="12" />
          </div>
        </div>
        <div class="status-bar"><p class="status-bar-field">Ready</p><p class="status-bar-field">Gallery folder</p></div>
      </section>

      <section class="window computer-window" id="computer-window" aria-label="My Computer" hidden>
        <div class="title-bar window-header">
          <div class="title-bar-text window-title"><img class="title-icon" src="/assets/icons/win98-computer.svg" alt=""> My Computer</div>
          <div class="title-bar-controls window-controls">
            <button aria-label="Minimize" data-action="minimize"></button>
            <button aria-label="Maximize" data-action="maximize"></button>
            <button aria-label="Close" data-action="close"></button>
          </div>
        </div>
        <div class="window-body window-content">
          <div class="computer-toolbar">
            <button type="button" data-window="welcome-window">Back</button>
            <button type="button">Up</button>
            <label class="address-bar">Address: <input type="text" value="My Computer" readonly></label>
          </div>
          <div class="computer-drives">
            <button class="drive-item" type="button" data-window="content-window"><img src="/assets/icons/win98-folder.svg" alt=""> Website (C:)</button>
            <button class="drive-item" type="button" data-window="blog-window"><img src="/assets/icons/win98-folder.svg" alt=""> Blog (D:)</button>
            <button class="drive-item" type="button" data-window="gallery-window"><img src="/assets/icons/win98-folder.svg" alt=""> Gallery (E:)</button>
            <button class="drive-item" type="button" data-window="about-window"><img src="/assets/icons/win98-document.svg" alt=""> About.txt</button>
            <button class="drive-item" type="button" data-window="control-panel-window"><span>⚙</span> Control Panel</button>
            <button class="drive-item" type="button" data-window="help-window"><img src="/assets/icons/win98-help.svg" alt=""> Help</button>
            <button class="drive-item" type="button" data-action="bsod"><span>▧</span> System (A:)</button>
          </div>
        </div>
      </section>

      <section class="window control-panel-window" id="control-panel-window" aria-label="Control Panel" hidden>
        <div class="title-bar window-header">
          <div class="title-bar-text window-title">⚙ Control Panel</div>
          <div class="title-bar-controls window-controls">
            <button aria-label="Minimize" data-action="minimize"></button>
            <button aria-label="Close" data-action="close"></button>
          </div>
        </div>
        <div class="window-body window-content">
          <div class="control-panel-grid">
            <button type="button" data-theme="default"><span>▦</span> Classic Teal</button>
            <button type="button" data-theme="night"><span>◐</span> Night Mode</button>
            <button type="button" data-theme="rose"><span>◆</span> Rose Gold</button>
            <button type="button" data-theme="galaxy"><span>✦</span> Galaxy</button>
          </div>
        </div>
      </section>

      <section class="window help-window" id="help-window" aria-label="Help" hidden>
        <div class="title-bar window-header">
          <div class="title-bar-text window-title"><img class="title-icon" src="/assets/icons/win98-help.svg" alt=""> Windows Help</div>
          <div class="title-bar-controls window-controls">
            <button aria-label="Minimize" data-action="minimize"></button>
            <button aria-label="Close" data-action="close"></button>
          </div>
        </div>
        <div class="window-body window-content help-content">
          <h3>How to use this site</h3>
          <ul>
            <li>Double-click icons to open windows.</li>
            <li>Drag title bars to move windows.</li>
            <li>Drag the bottom-right corner to resize windows.</li>
            <li>Use Blog (D:) and Gallery (E:) as editable Squarespace content folders.</li>
            <li>Try Shut Down if you want the blue screen.</li>
          </ul>
        </div>
      </section>
    </div>

    <div id="taskbar" class="taskbar startbar">
      <button id="start-button" class="startbutton-off" type="button" aria-expanded="false"><span class="start-mark">▦</span><b>Start</b></button>
      <div id="taskbar-programs" aria-label="Open windows"></div>
      <div id="clock" class="time"><span class="tray-dot">◉</span><span id="time-display">--:--</span></div>
    </div>

    <nav id="start-menu" class="start-menu" hidden aria-label="Start menu">
      <div class="menu-sidebar"><div class="headline"><strong>Windows</strong> 98</div></div>
      <ul class="menu-content">
        <li class="item folder"><img class="menu-icon" src="/assets/icons/win98-folder.svg" alt=""><em>P</em>rograms
          <ul class="menu-content">
            <li class="item folder"><img class="menu-icon" src="/assets/icons/win98-folder.svg" alt="">Accessories
              <ul class="menu-content">
                <li class="item" data-window="about-window"><img class="menu-icon" src="/assets/icons/win98-document.svg" alt="">Notepad</li>
                <li class="item" data-window="help-window"><img class="menu-icon" src="/assets/icons/win98-help.svg" alt="">Help</li>
              </ul>
            </li>
            <li class="item" data-window="content-window"><img class="menu-icon" src="/assets/icons/win98-folder.svg" alt="">Internet Explorer</li>
            <li class="item" data-window="control-panel-window"><span class="menu-glyph">⚙</span>Control Panel</li>
          </ul>
        </li>
        <li class="item folder"><img class="menu-icon" src="/assets/icons/win98-document.svg" alt=""><em>D</em>ocuments
          <ul class="menu-content">
            <li class="item" data-window="content-window"><img class="menu-icon" src="/assets/icons/win98-folder.svg" alt="">Website</li>
            <li class="item" data-window="about-window"><img class="menu-icon" src="/assets/icons/win98-document.svg" alt="">About.txt</li>
            <li class="item" data-window="blog-window"><img class="menu-icon" src="/assets/icons/win98-folder.svg" alt="">Blog (D:)</li>
            <li class="item" data-window="gallery-window"><img class="menu-icon" src="/assets/icons/win98-folder.svg" alt="">Gallery (E:)</li>
          </ul>
        </li>
        <li class="item folder"><span class="menu-glyph">⚙</span><em>S</em>ettings
          <ul class="menu-content">
            <li class="item" data-window="control-panel-window"><span class="menu-glyph">⚙</span>Control Panel</li>
            <li class="item" data-theme="default"><span class="menu-glyph">▦</span>Classic Teal</li>
            <li class="item" data-theme="night"><span class="menu-glyph">◐</span>Night Mode</li>
          </ul>
        </li>
        <li class="item" data-window="computer-window"><img class="menu-icon" src="/assets/icons/win98-computer.svg" alt="">My Computer</li>
        <li class="item" data-window="blog-window"><img class="menu-icon" src="/assets/icons/win98-folder.svg" alt="">Blog</li>
        <li class="item" data-window="gallery-window"><img class="menu-icon" src="/assets/icons/win98-folder.svg" alt="">Gallery</li>
        <li class="item" data-window="help-window"><img class="menu-icon" src="/assets/icons/win98-help.svg" alt="">Help</li>
        <li class="item" data-action="recycle-bin"><span class="menu-glyph">♲</span>Recycle Bin</li>
        <li class="divider"></li>
        <li class="item" data-action="bsod"><span class="menu-glyph">⏻</span>Shut Down...</li>
      </ul>
    </nav>

    <div id="bsod" class="bsod" hidden tabindex="-1">
      <div class="bsod-content">
        <h1>A fatal exception 0E has occurred at 0028:C0011E36.</h1>
        <p>The current application will be terminated.</p>
        <br>
        <p>* Press any key to return to the desktop.</p>
        <p>* Press CTRL+ALT+DEL to restart your computer.</p>
        <br>
        <p>Press any key to continue _</p>
      </div>
    </div>

    <squarespace:script src="windows98.js" combo="false" />
    {squarespace-footers}
  </body>
</html>
